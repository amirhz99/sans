ADMIN_GROUP_ID=
# allowlist (default) or group_members (everyone interacting in this group is trusted)
ADMIN_ACCESS=allowlist
# Explicit allowlist, comma-separated numeric Bale user IDs
ADMIN_USER_IDS=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
DATABASE_PATH=data/sans.sqlite3
BOT_NAME=مسئول
# Ask admins about unfinished sessions / pending receipts every 24 hours. 0 disables.
REMINDER_HOURS=24