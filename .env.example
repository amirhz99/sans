BALE_BOT_TOKEN=
# Numeric ID of the private admin group (often negative)
ADMIN_GROUP_ID=
# Retained for compatibility; all members of ADMIN_GROUP_ID are trusted.
ADMIN_ACCESS=allowlist
# Retained for compatibility; no allowlist is required for group access.
ADMIN_USER_IDS=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: comma-separated models tried in order when the primary model fails.
AI_FALLBACK_MODEL=
DATABASE_PATH=data/sans.sqlite3
BOT_NAME=مسئول
# Ask admins about unfinished sessions / pending receipts every 24 hours. 0 disables.
REMINDER_HOURS=24
# Optional: a plain Bale handle (e.g. @club_support) the bot hands a user to when it
# cannot resolve their problem. Leave empty to disable the hand-off.
SUPPORT_HANDLE=
