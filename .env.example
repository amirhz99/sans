BALE_BOT_TOKEN=
# Numeric ID of the private admin group (often negative)
ADMIN_GROUP_ID=
# Default: every member of ADMIN_GROUP_ID is an admin, and nobody is an admin
# in a private chat.  Set to `allowlist` only if you also want the ids in
# ADMIN_USER_IDS to keep admin powers in their private chat with the bot.
ADMIN_ACCESS=group_members
# Optional; only used when ADMIN_ACCESS=allowlist.  Empty means no private admin.
ADMIN_USER_IDS=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: comma-separated models tried in order when the primary model fails.
AI_FALLBACK_MODEL=
DATABASE_PATH=data/sans.sqlite3
BOT_NAME=مسئول
# Ask admins about unfinished sessions / pending receipts every 24 hours. 0 disables.
REMINDER_HOURS=24
# Optional: a plain Bale handle (e.g. @club_support) the bot hands a user to when it
# cannot resolve their problem. Leave empty to disable the hand-off.
SUPPORT_HANDLE=
